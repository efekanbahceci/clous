{
  "name": "@clous/server",
  "version": "0.1.4",
  "description": "Clous Runtime Engine - Dynamic Type-Safe CRUD Server with RLS & Web Panel Integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clous/core": "^1.0.6",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "mongodb": "^7.7.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/efekanbahceci/clous.git",
    "directory": "packages/server"
  },
  "homepage": "https://clous.dev",
  "bugs": {
    "url": "https://github.com/efekanbahceci/clous/issues"
  },
  "keywords": [
    "clous",
    "server",
    "api",
    "baas",
    "fastify",
    "orm"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
